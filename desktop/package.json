{
  "name": "dog-verb",
  "version": "1.0.0",
  "description": "Dog Verb desktop pet",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --win",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "desktop-pet",
    "electron",
    "cute",
    "widget"
  ],
  "author": "Desktop Pet Generator",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {},
  "build": {
    "appId": "com.desktoppet.dogverb",
    "productName": "Dog Verb",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "renderer.js",
      "index.html",
      "package.json",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "dir"
      ]
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Utility"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "productName": "Dog Verb"
}